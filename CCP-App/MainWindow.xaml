<Window x:Class="CCP_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CCP_App"
        mc:Ignorable="d"
        Title="CCP: Encryption Algorithms" Height="640" Width="480"
        ResizeMode="CanMinimize">
    <Grid>
        <Label Content="Encryption Algorithms" Margin="0,13,0,0" VerticalAlignment="Top" FontSize="24px" HorizontalAlignment="Center"/>
        <Label Content="Cross Curriculum Project:" Height="27" VerticalAlignment="Top" HorizontalAlignment="Center"  FontStyle="Italic" Margin="0,2,0,0"/>
        <Label Content="① What are Encryption Algorithms?&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;② How are they different from Encoding Algorithms?" HorizontalAlignment="Left" Height="152" Margin="10,70,0,0" VerticalAlignment="Top" Width="444" FontSize="18px"/>
        <Rectangle Height="1" Margin="38,58,38,0" Stroke="Black" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Rectangle Height="1" Margin="38,260,38,0" Stroke="Black" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <Button Content="Next" FontSize="20px" Height="34" Margin="351,560,22,0" VerticalAlignment="Top" Click="NextButtonClick"/>
        <TextBox Name="b64left" HorizontalAlignment="Left" Height="52" Margin="38,338,0,0" TextWrapping="Wrap" Text="Type some text here!" VerticalAlignment="Top" Width="194"/>
        <TextBox Name="b64right" HorizontalAlignment="Left" Height="52" Margin="232,338,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="194"/>
        <Button Content="Encode to Base64" HorizontalAlignment="Left" Height="21" Margin="129,317,0,0" VerticalAlignment="Top" Width="103" Click="encodeB64Button"/>
        <Button Content="Decode to Text" HorizontalAlignment="Left" Height="21" Margin="232,317,0,0" VerticalAlignment="Top" Width="103" Click="decodeB64Button"/>
        <TextBlock HorizontalAlignment="Center" Height="71" Margin="0,100,0,0" TextWrapping="Wrap" Text="Encryption algorithms are mathematical methods that are used to convert readable information into scrambled information like ciphertext so that unauthorized people cannot access it. They protect digital privacy by securing passwords and messages, along with banking information and online communications. " VerticalAlignment="Top" Width="460"/>
        <TextBlock HorizontalAlignment="Center" Height="71" Margin="0,196,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="460"><Run Text="Encryption protects data for security and requires a key to decode the information. Encoding changes data into a different format, such as Base64 or ASCII 85, so computers can store or transfer it more easily, but it is not designed for security. "/><LineBreak/><Run/></TextBlock>
        <TextBox x:Name="a85left" HorizontalAlignment="Left" Height="52" Margin="38,428,0,0" TextWrapping="Wrap" Text="Type some text here!" VerticalAlignment="Top" Width="194"/>
        <TextBox x:Name="a85right" HorizontalAlignment="Left" Height="52" Margin="232,428,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="194"/>
        <Button Content="Encode to ASCII85" HorizontalAlignment="Left" Height="21" Margin="180,407,0,0" VerticalAlignment="Top" Width="104" Click="encodeA85Button"/>
        <Button  Content="Decode to Text" Visibility="hidden" IsEnabled="false" HorizontalAlignment="Left" ToolTip="Currently Disabled" Height="21" Margin="232,407,0,0" VerticalAlignment="Top" Width="103" Click="decodeA85Button"/>
        <Button Content="Save" FontSize="20px" Height="34" Margin="22,560,351,0" VerticalAlignment="Top" Click="saveEncodes" ToolTip="Save encoded and decoded strings to a local file." />
    </Grid>
</Window>
