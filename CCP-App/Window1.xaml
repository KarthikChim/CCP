<Window x:Class="CCP_App.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CCP_App"
        mc:Ignorable="d"
        ResizeMode="CanMinimize"
        Title="CCP: Digital Surveillance" Height="640" Width="480">
    <Grid>
        <Label Content="Digital Surveillance" Margin="0,13,0,0" VerticalAlignment="Top" FontSize="24px" HorizontalAlignment="Center"/>
        <Label Content="Cross Curriculum Project:" Height="27" VerticalAlignment="Top" HorizontalAlignment="Center"  FontStyle="Italic" Margin="0,2,0,0"/>
        <Rectangle Height="1" Margin="38,58,38,0" Stroke="Black" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleY="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>
        <TextBlock TextAlignment="Center" ToolTip="This report details the hardware and software aspects of your computer. What's important to note is that these configurations are typically unique and distinct from one another, so having this information can uniquely identify your device from others, in what's called 'fingerprinting.'" Height="56" Margin="0,81,0,0" TextWrapping="Wrap" Text="There is a lot of information about your device. These can be used to surveil you!" FontSize="20px" VerticalAlignment="Top" Width="404" HorizontalAlignment="Center" />
        <TextBox x:Name="reportText" ToolTip="Scroll! This list never ends." HorizontalAlignment="Center" Height="428" Margin="0,151,0,0" TextWrapping="Wrap" Text="Processing report, please wait" VerticalAlignment="Top" Width="404" FontFamily="Courier New" IsReadOnly="True" />
    </Grid>
</Window>
